        && incoming().updatedAt == request.time
        && (existing().status != 'closed' || isOpsManagerOrAbove() || hasModulePerm('executive', 'approve'))
        && (isAdmin() || hasModulePerm('executive', 'edit') || existing().createdByUid == request.auth.uid || existing().assigneeUid == request.auth.uid);
      allow delete: if isValidId(noteTaskId) && (isAdmin() || hasModulePerm('executive', 'delete') || existing().createdByUid == request.auth.uid);
    }

    // ==========================================
    // SYSTEM BUILDER & ENTERPRISE CUSTOMIZATION COLLECTIONS
    // ==========================================

    // 30. companyBranding
    match /companyBranding/{brandingId} {
      allow get: if isValidId(brandingId) && isActiveMember();
      allow list: if canListResource();
      allow create: if isValidId(brandingId) && (isAdmin() || hasModulePerm('branding', 'add') || hasModulePerm('company', 'add'))
        && isValidCompanyBranding(incoming(), brandingId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(brandingId) && (isAdmin() || hasModulePerm('branding', 'edit') || hasModulePerm('company', 'edit'))
        && isValidCompanyBranding(incoming(), brandingId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(brandingId) && isBootstrappedOwner();
    }

    // 31. systemSections
    match /systemSections/{sectionId} {
      allow get: if isValidId(sectionId) && isActiveMember();
      allow list: if canListResource();
      allow create: if isValidId(sectionId) && (isAdmin() || hasModulePerm('builder', 'add'))
        && isValidSystemSection(incoming(), sectionId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(sectionId) && (isAdmin() || hasModulePerm('builder', 'edit'))
        && isValidSystemSection(incoming(), sectionId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(sectionId) && (isAdmin() || hasModulePerm('builder', 'delete')) && existing().isBuiltIn != true;
    }

    // 32. systemPages
    match /systemPages/{pageId} {
      allow get: if isValidId(pageId) && isActiveMember();
      allow list: if canListResource();
      allow create: if isValidId(pageId) && (isAdmin() || hasModulePerm('builder', 'add'))
        && isValidSystemPage(incoming(), pageId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(pageId) && (isAdmin() || hasModulePerm('builder', 'edit'))
        && isValidSystemPage(incoming(), pageId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(pageId) && (isAdmin() || hasModulePerm('builder', 'delete')) && existing().isBuiltIn != true;
    }

    // 33. dynamicFields
    match /dynamicFields/{fieldId} {
      allow get: if isValidId(fieldId) && isActiveMember();
      allow list: if canListResource();
      allow create: if isValidId(fieldId) && (isAdmin() || hasModulePerm('builder', 'add'))
        && isValidDynamicField(incoming(), fieldId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(fieldId) && (isAdmin() || hasModulePerm('builder', 'edit'))
        && isValidDynamicField(incoming(), fieldId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(fieldId) && (isAdmin() || hasModulePerm('builder', 'delete')) && existing().isCore != true;
    }

    // 34. dynamicForms
    match /dynamicForms/{formId} {
      allow get: if isValidId(formId) && isActiveMember();
      allow list: if canListResource();
      allow create: if isValidId(formId) && (isAdmin() || hasModulePerm('builder', 'add'))
        && isValidDynamicForm(incoming(), formId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(formId) && (isAdmin() || hasModulePerm('builder', 'edit'))
        && isValidDynamicForm(incoming(), formId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(formId) && (isAdmin() || hasModulePerm('builder', 'delete'));
    }

    // 35. dynamicFormVersions
    match /dynamicFormVersions/{versionId} {
      allow get: if isValidId(versionId) && (isAdmin() || hasModulePerm('builder', 'view'));
      allow list: if canListResource();
      allow create: if isValidId(versionId) && (isAdmin() || hasModulePerm('builder', 'edit') || hasModulePerm('builder', 'add'))
        && isValidDynamicFormVersion(incoming(), versionId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(versionId) && isBootstrappedOwner();
    }

    // 36. customEntityRecords
    match /customEntityRecords/{recordId} {
      allow get: if isValidId(recordId) && isActiveMember();
      allow list: if canListResource();
      allow create: if isValidId(recordId) && isActiveMember()
        && isValidCustomEntityRecord(incoming(), recordId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(recordId) && isActiveMember()
        && isValidCustomEntityRecord(incoming(), recordId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(recordId) && (isAdmin() || existing().createdByUid == request.auth.uid);
    }

    // 37. savedViews
    match /savedViews/{viewId} {
      allow get: if isValidId(viewId) && isActiveMember() && (existing().isShared == true || existing().ownerUid == request.auth.uid);
      allow list: if canListResource();
      allow create: if isValidId(viewId) && isActiveMember()
        && isValidSavedView(incoming(), viewId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(viewId) && isActiveMember()
        && (isAdmin() || existing().ownerUid == request.auth.uid)
        && isValidSavedView(incoming(), viewId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(viewId) && (isAdmin() || existing().ownerUid == request.auth.uid);
    }

    // 38. userPreferences
    match /userPreferences/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isVerified() && existing().userId == request.auth.uid;
      allow create: if isValidId(userId) && isOwner(userId)
        && isValidUserPreference(incoming(), userId)
        && incoming().createdByUid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId)
        && isValidUserPreference(incoming(), userId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // 39. notificationRules
    match /notificationRules/{ruleId} {
      allow get: if isValidId(ruleId) && isActiveMember();
      allow list: if canListResource();
      allow create: if isValidId(ruleId) && (isAdmin() || hasModulePerm('settings', 'add') || hasModulePerm('builder', 'add'))
        && isValidNotificationRule(incoming(), ruleId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(ruleId) && (isAdmin() || hasModulePerm('settings', 'edit') || hasModulePerm('builder', 'edit'))
        && isValidNotificationRule(incoming(), ruleId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(ruleId) && (isAdmin() || hasModulePerm('settings', 'delete') || hasModulePerm('builder', 'delete'));
    }

    // 40. trashItems
    match /trashItems/{trashId} {
      allow get: if isValidId(trashId) && (isAdmin() || hasModulePerm('trash', 'view') || hasModulePerm('builder', 'view'));
      allow list: if canListResource();
      allow create: if isValidId(trashId) && (isAdmin() || hasModulePerm('trash', 'add') || hasModulePerm('builder', 'delete') || hasModulePerm('hr', 'delete') || hasModulePerm('fleet', 'delete'))
        && isValidTrashItem(incoming(), trashId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(trashId) && (isAdmin() || hasModulePerm('trash', 'edit') || hasModulePerm('builder', 'edit'))
        && isValidTrashItem(incoming(), trashId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(trashId) && (isAdmin() || hasModulePerm('trash', 'delete'));
    }

    // 41. configSnapshots
    match /configSnapshots/{snapshotId} {
      allow get: if isValidId(snapshotId) && (isAdmin() || hasModulePerm('builder', 'view'));
      allow list: if canListResource();
      allow create: if isValidId(snapshotId) && (isAdmin() || hasModulePerm('builder', 'add'))
        && isValidConfigSnapshot(incoming(), snapshotId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(snapshotId) && (isAdmin() || hasModulePerm('builder', 'delete'));
    }

    // 42. customReportTemplates
    match /customReportTemplates/{templateId} {
      allow get: if isValidId(templateId) && (isActiveMember() || hasModulePerm('reports', 'view'));
      allow list: if canListResource();
      allow create: if isValidId(templateId) && (isAdmin() || hasModulePerm('reports', 'view') || hasModulePerm('reports', 'export'))
        && isValidCustomReportTemplate(incoming(), templateId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(templateId) && (isAdmin() || existing().createdByUid == request.auth.uid || hasModulePerm('reports', 'approve'))
        && isValidCustomReportTemplate(incoming(), templateId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(templateId) && (isAdmin() || existing().createdByUid == request.auth.uid);
    }
  }
}
