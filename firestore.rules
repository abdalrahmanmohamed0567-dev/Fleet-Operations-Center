        && isValidRiderIdentityMapping(incoming(), mappingId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['internalRiderId', 'platformRiderName', 'allowedUids', 'updatedAt']));
      allow delete: if isValidId(mappingId) && isOpsManagerOrAbove();
    }

    // 4. importBatches
    match /importBatches/{batchId} {
