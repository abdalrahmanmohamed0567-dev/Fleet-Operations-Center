rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedOwner() {
      return isVerified()
        && ('email' in request.auth.token)
        && request.auth.token.email.lower() == 'abdalrahmanmohamed0567@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasActiveRole(roles) {
      return isBootstrappedOwner() || (
        isVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserDoc().data.active == true
        && getUserDoc().data.role in roles
      );
    }

    function isAdmin() {
      return hasActiveRole(['owner', 'admin']);
    }

    function isOpsManagerOrAbove() {
      return hasActiveRole(['owner', 'admin', 'operations_manager']);
    }

    function isSupervisorOrAbove() {
      return hasActiveRole(['owner', 'admin', 'operations_manager', 'supervisor']);
    }

    function isHrStaff() {
      return hasActiveRole(['owner', 'admin', 'operations_manager', 'hr_manager', 'hr_employee']);
    }

    function isFleetStaff() {
      return hasActiveRole(['owner', 'admin', 'operations_manager', 'fleet_manager', 'fleet_employee']);
    }

    function isActiveMember() {
      return hasActiveRole([
        'owner', 'admin', 'operations_manager', 'supervisor', 'viewer',
        'hr_manager', 'hr_employee', 'fleet_manager', 'fleet_employee', 'accountant'
      ]);
    }

    function hasModulePerm(mod, action) {
      return isBootstrappedOwner()
        || isAdmin()
        || (
          isVerified()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && getUserDoc().data.active == true
          && (
            (
              'permissionOverrides' in getUserDoc().data
              && getUserDoc().data.permissionOverrides is map
              && mod in getUserDoc().data.permissionOverrides
              && getUserDoc().data.permissionOverrides[mod] is map
              && action in getUserDoc().data.permissionOverrides[mod]
            )
              ? getUserDoc().data.permissionOverrides[mod][action] == true
              : (
                (
                  'customRoleId' in getUserDoc().data
                  && getUserDoc().data.customRoleId is string
                  && getUserDoc().data.customRoleId.size() >= 1
                  && exists(/databases/$(database)/documents/roleTemplates/$(getUserDoc().data.customRoleId))
                )
                  ? (
                    get(/databases/$(database)/documents/roleTemplates/$(getUserDoc().data.customRoleId)).data.permissions is map
                    && mod in get(/databases/$(database)/documents/roleTemplates/$(getUserDoc().data.customRoleId)).data.permissions
                    && get(/databases/$(database)/documents/roleTemplates/$(getUserDoc().data.customRoleId)).data.permissions[mod] is map
                    && action in get(/databases/$(database)/documents/roleTemplates/$(getUserDoc().data.customRoleId)).data.permissions[mod]
                    && get(/databases/$(database)/documents/roleTemplates/$(getUserDoc().data.customRoleId)).data.permissions[mod][action] == true
                  )
                  : (
                    (mod == 'hr' && (action == 'view' ? isActiveMember() : isHrStaff()))
                    || (mod == 'documents' && (action == 'view' ? isActiveMember() : (isHrStaff() || isFleetStaff())))
                    || (mod == 'applications' && (action == 'view' ? isActiveMember() : isSupervisorOrAbove()))
                    || (mod == 'fleet' && (action == 'view' ? isActiveMember() : isFleetStaff()))
                    || (mod == 'operations' && (action == 'view' ? isActiveMember() : isSupervisorOrAbove()))
                    || (mod == 'settings' && (action == 'view' ? isActiveMember() : isOpsManagerOrAbove()))
                    || (mod == 'executive' && (action == 'view' ? isActiveMember() : isOpsManagerOrAbove()))
                    || (mod == 'platforms' && (action == 'view' ? isActiveMember() : isAdmin()))
                    || (mod == 'builder' && (action == 'view' ? isActiveMember() : isAdmin()))
                    || (mod == 'branding' && (action == 'view' ? isActiveMember() : isAdmin()))
                    || (mod == 'company' && (action == 'view' ? isActiveMember() : isAdmin()))
                    || (mod == 'system_health' && isAdmin())
                    || (mod == 'trash' && (action == 'view' ? isAdmin() : isAdmin()))
                  )
              )
          )
        );
    }

    function hasPlatformAccess(platform) {
      return isBootstrappedOwner()
        || hasActiveRole(['owner', 'admin'])
        || (
          isActiveMember()
          && (
            !('allowedPlatforms' in getUserDoc().data)
            || platform in getUserDoc().data.allowedPlatforms
          )
        );
    }

    // Zero-get() list gate using bounded allowedUids or creator/bootstrapped owner
    function canListResource() {
      return isVerified() && (
        isBootstrappedOwner()
        || existing().createdByUid == request.auth.uid
        || (
          existing().allowedUids is list
          && existing().allowedUids.size() <= 20
          && request.auth.uid in existing().allowedUids
        )
      );
    }

    function isValidAllowedUids(listVal) {
      return listVal is list
        && listVal.size() >= 1
        && listVal.size() <= 20
        && listVal[0] is string
        && listVal[0].size() <= 128;
    }

    function isValidIsoDate(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalNum(data, field) {
      return !(field in data) || data[field] is number || data[field] == null;
    }

    function isOptionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function isOptionalMap(data, field) {
      return !(field in data) || data[field] is map;
    }

    // Entity Validation Helpers
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'customRoleId', 'active',
          'allowedPlatforms', 'assignedBranch', 'assignedCity', 'dataScope',
          'permissionOverrides', 'capabilityOverrides', 'managedByAdminUids', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in [
          'owner', 'admin', 'operations_manager', 'supervisor', 'viewer',
          'hr_manager', 'hr_employee', 'fleet_manager', 'fleet_employee', 'accountant'
        ]
        && isOptionalString(data, 'customRoleId', 64)
        && data.active is bool
        && (!('allowedPlatforms' in data) || (
          data.allowedPlatforms is list
          && data.allowedPlatforms.size() >= 1
          && data.allowedPlatforms.size() <= 2
          && data.allowedPlatforms[0] in ['hungerstation', 'keeta']
          && (data.allowedPlatforms.size() == 1 || data.allowedPlatforms[1] in ['hungerstation', 'keeta'])
        ))
        && isOptionalString(data, 'assignedBranch', 100)
        && isOptionalString(data, 'assignedCity', 100)
        && (!('dataScope' in data) || data.dataScope is map)
        && (!('permissionOverrides' in data) || data.permissionOverrides is map)
        && isOptionalMap(data, 'capabilityOverrides')
        && (!('managedByAdminUids' in data) || (data.managedByAdminUids is list && data.managedByAdminUids.size() <= 10))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRiderMaster(data, docId) {
      return data.keys().hasAll(['internalRiderId', 'fullName', 'status', 'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'internalRiderId', 'fullName', 'iqamaNumber', 'iqamaIssueDate', 'iqamaExpiryDate', 'iqamaRenewalNotes',
          'phone', 'birthDate', 'nationality', 'joinDate', 'exitDate',
          'driverLicenseNumber', 'driverLicenseType', 'driverLicenseIssueDate', 'driverLicenseExpiryDate',
          'adminNotes', 'city', 'branch', 'supervisor', 'contractName', 'vehicleType',
          'status', 'statusHistory', 'customFields', 'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'
        ])
        && data.internalRiderId == docId
        && isValidId(data.internalRiderId)
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150
        && data.status in ['new', 'onboarding', 'ready', 'active', 'suspended', 'on_leave', 'terminated', 'inactive']
        && isOptionalString(data, 'iqamaNumber', 40)
        && isOptionalString(data, 'iqamaIssueDate', 10)
        && isOptionalString(data, 'iqamaExpiryDate', 10)
        && isOptionalString(data, 'iqamaRenewalNotes', 600)
        && isOptionalString(data, 'phone', 32)
        && isOptionalString(data, 'birthDate', 10)
        && isOptionalString(data, 'nationality', 80)
        && isOptionalString(data, 'joinDate', 10)
        && isOptionalString(data, 'exitDate', 10)
        && isOptionalString(data, 'driverLicenseNumber', 40)
        && isOptionalString(data, 'driverLicenseType', 60)
        && isOptionalString(data, 'driverLicenseIssueDate', 10)
        && isOptionalString(data, 'driverLicenseExpiryDate', 10)
        && isOptionalString(data, 'adminNotes', 1500)
        && isOptionalString(data, 'city', 100)
        && isOptionalString(data, 'branch', 100)
        && isOptionalString(data, 'supervisor', 100)
        && isOptionalString(data, 'contractName', 120)
        && isOptionalString(data, 'vehicleType', 64)
        && (!('statusHistory' in data) || (data.statusHistory is list && data.statusHistory.size() <= 50))
        && isOptionalMap(data, 'customFields')
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRiderIdentityMapping(data, docId) {
      return data.keys().hasAll(['mappingId', 'internalRiderId', 'platform', 'platformRiderId', 'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['mappingId', 'internalRiderId', 'platform', 'platformRiderId', 'platformRiderName', 'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'])
        && data.mappingId == docId
        && isValidId(data.mappingId)
        && isValidId(data.internalRiderId)
        && data.platform in ['hungerstation', 'keeta']
        && data.platformRiderId is string && data.platformRiderId.size() >= 1 && data.platformRiderId.size() <= 64
        && isOptionalString(data, 'platformRiderName', 150)
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidImportBatch(data, docId) {
      return data.keys().hasAll(['batchId', 'fileName', 'fileHash', 'platform', 'sourceType', 'validCount', 'duplicateCount', 'rejectedCount', 'status', 'createdByUid', 'allowedUids', 'createdAt'])
        && data.keys().hasOnly(['batchId', 'fileName', 'fileHash', 'platform', 'sourceType', 'driveFileId', 'detectedPeriodStart', 'detectedPeriodEnd', 'sheetsDetected', 'unknownColumns', 'validCount', 'duplicateCount', 'rejectedCount', 'updatedCount', 'status', 'importedByEmail', 'createdByUid', 'allowedUids', 'createdAt'])
        && data.batchId == docId
        && isValidId(data.batchId)
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 255
        && data.fileHash is string && data.fileHash.size() >= 1 && data.fileHash.size() <= 128
        && data.platform in ['hungerstation', 'keeta']
        && data.sourceType in ['local', 'google_drive']
        && isOptionalString(data, 'driveFileId', 200)
        && isOptionalString(data, 'detectedPeriodStart', 20)
        && isOptionalString(data, 'detectedPeriodEnd', 20)
        && (!('sheetsDetected' in data) || (data.sheetsDetected is list && data.sheetsDetected.size() <= 20))
        && (!('unknownColumns' in data) || (data.unknownColumns is list && data.unknownColumns.size() <= 100))
        && data.validCount is number && data.duplicateCount is number && data.rejectedCount is number
        && isOptionalNum(data, 'updatedCount')
        && data.status in ['previewed', 'committed', 'failed']
        && isOptionalString(data, 'importedByEmail', 200)
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp;
    }

    function isValidHungerDaily(data, docId) {
      return data.keys().hasAll(['recordKey', 'platform', 'riderId', 'date', 'month', 'sourceFile', 'sourceSheet', 'importBatchId', 'rowChecksum', 'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'])
        && data.keys().hasOnly([
          'recordKey', 'platform', 'riderId', 'date', 'month', 'city', 'contractName', 'vehicleName',
          'batchNumber', 'tgaStatus', 'errorCodes', 'shifts', 'plannedWorkingHours', 'actualWorkingHours',
          'avgWorkingHoursPerDay', 'attendanceRate', 'breakHours', 'lostHours', 'acceptanceRate',
          'contactRate', 'noShows', 'noShowPct', 'notifiedDeliveries', 'completedDeliveries',
          'acceptedDeliveries', 'stackedDeliveries', 'declinedDeliveries', 'cancelledDeliveries',
          'deductionDeliveries', 'notAcceptedDeliveries', 'manualUndispatched', 'chatResponsePct',
          'sourceFile', 'sourceSheet', 'sourceRowNumber', 'importBatchId', 'rowChecksum',
          'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'
        ])
        && data.recordKey == docId && isValidId(data.recordKey)
        && data.platform == 'hungerstation'
        && data.riderId is string && data.riderId.size() >= 1 && data.riderId.size() <= 64
        && isValidIsoDate(data.date)
        && data.month is string && data.month.size() == 7
        && isOptionalString(data, 'errorCodes', 500)
        && isValidString(data.sourceFile, 255)
        && isValidString(data.sourceSheet, 100)
        && isValidString(data.importBatchId, 128)
        && isValidString(data.rowChecksum, 128)
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.importedAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidHungerDistanceDaily(data, docId) {
      return data.keys().hasAll(['recordKey', 'platform', 'riderId', 'date', 'month', 'sourceFile', 'sourceSheet', 'importBatchId', 'rowChecksum', 'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'])
        && data.keys().hasOnly([
          'recordKey', 'platform', 'riderId', 'date', 'month', 'city', 'contractName',
          'totalKm', 'payableKm', 'avgKm', 'completedDeliveries',
          'sourceFile', 'sourceSheet', 'sourceRowNumber', 'importBatchId', 'rowChecksum',
          'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'
        ])
        && data.recordKey == docId && isValidId(data.recordKey)
        && data.platform == 'hungerstation'
        && data.riderId is string && data.riderId.size() >= 1 && data.riderId.size() <= 64
        && isValidIsoDate(data.date)
        && data.month is string && data.month.size() == 7
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.importedAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidHungerWalletSnapshot(data, docId) {
      return data.keys().hasAll(['recordKey', 'platform', 'riderId', 'snapshotDate', 'currentWallet', 'sourceFile', 'sourceSheet', 'importBatchId', 'rowChecksum', 'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'])
        && data.keys().hasOnly([
          'recordKey', 'platform', 'riderId', 'snapshotDate', 'currentWallet',
          'sourceFile', 'sourceSheet', 'sourceRowNumber', 'importBatchId', 'rowChecksum',
          'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'
        ])
        && data.recordKey == docId && isValidId(data.recordKey)
        && data.platform == 'hungerstation'
        && data.riderId is string && data.riderId.size() >= 1 && data.riderId.size() <= 64
        && isValidIsoDate(data.snapshotDate)
        && data.currentWallet is number
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.importedAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidHungerQualityMonthly(data, docId) {
      return data.keys().hasAll(['recordKey', 'platform', 'riderId', 'month', 'sourceFile', 'sourceSheet', 'importBatchId', 'rowChecksum', 'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'])
        && data.keys().hasOnly([
          'recordKey', 'platform', 'riderId', 'month', 'city', 'contractName', 'vehicleType',
          'totalVerificationRequests', 'successfulVerificationRequests', 'verificationSuccessRate',
          'grossOrders', 'completedOrders', 'completedOrdersInTime', 'failedOrdersByRider',
          'onTimeDeliveryScore', 'failRateScore', 'finalDeliveryQualityScore', 'segment',
          'sourceFile', 'sourceSheet', 'sourceRowNumber', 'importBatchId', 'rowChecksum',
          'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'
        ])
        && data.recordKey == docId && isValidId(data.recordKey)
        && data.platform == 'hungerstation'
        && data.riderId is string && data.riderId.size() >= 1 && data.riderId.size() <= 64
        && data.month is string && data.month.size() >= 1 && data.month.size() <= 32
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.importedAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidKeetaDashboardDaily(data, docId) {
      return data.keys().hasAll(['recordKey', 'platform', 'riderId', 'date', 'month', 'sourceFile', 'sourceSheet', 'importBatchId', 'rowChecksum', 'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'])
        && data.keys().hasOnly([
          'recordKey', 'platform', 'riderId', 'date', 'month', 'firstName', 'lastName', 'fullName',
          'vehicleType', 'headquarters', 'branch', 'supervisor', 'courierType', 'shiftAttendanceSummary',
          'parsedShiftSlots', 'onShift', 'validDay', 'appOnlineTime', 'appOnlineTimeRaw',
          'shiftValidOnlineTime', 'shiftValidOnlineTimeRaw', 'shiftOnlineHours',
          'shiftPeAbdoOnlineHours', 'shiftPeAbdoOnlineHoursRaw',
          'acceptedTasks', 'restaurantArrivals', 'deliveredTasks', 'largeOrderTasksCompleted',
          'rejectedTasks', 'rejectedTasksCourier', 'rejectedTasksAuto', 'cancellationRate',
          'completionRate', 'onTimeRate', 'largeOrderOnTimeRate', 'avgDeliveryTimeMinutes',
          'deliveredOver55Min', 'deliveredOver55MinProp', 'overdueOrderTasks', 'severelyOverdueOrderTasks',
          'originalHeaders', 'rawExtraColumns',
          'sourceFile', 'sourceSheet', 'sourceRowNumber', 'importBatchId', 'rowChecksum',
          'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'
        ])
        && data.recordKey == docId && isValidId(data.recordKey)
        && data.platform == 'keeta'
        && data.riderId is string && data.riderId.size() >= 1 && data.riderId.size() <= 64
        && isValidIsoDate(data.date)
        && data.month is string && data.month.size() == 7
        && isOptionalString(data, 'shiftAttendanceSummary', 500)
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.importedAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidKeetaVdaDaily(data, docId) {
      return data.keys().hasAll(['recordKey', 'platform', 'riderId', 'date', 'month', 'sourceFile', 'sourceSheet', 'importBatchId', 'rowChecksum', 'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'])
        && data.keys().hasOnly([
          'recordKey', 'platform', 'riderId', 'date', 'month', 'firstOnlineDate', 'vehicleType',
          'threePlId', 'threePlName', 'pmm', 'ifNewRider',
          'shiftOnlineHours', 'sumValidShifts', 'shouldOnlineDays', 'totalDeliveredTasks',
          'sumDeliveredAdvanceTasks', 'onTimeDTasks', 'cancellationD', 'deliveredOver55Min',
          'acceptedOrders', 'vdaScore', 'totalDeliveryDistance', 'payableDistance',
          'shiftWindows', 'shiftsS1ToS6', 'originalHeaders', 'rawExtraColumns',
          'sourceFile', 'sourceSheet', 'sourceRowNumber', 'importBatchId', 'rowChecksum',
          'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'
        ])
        && data.recordKey == docId && isValidId(data.recordKey)
        && data.platform == 'keeta'
        && data.riderId is string && data.riderId.size() >= 1 && data.riderId.size() <= 64
        && isValidIsoDate(data.date)
        && data.month is string && data.month.size() == 7
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.importedAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidKeetaRankSnapshot(data, docId) {
      return data.keys().hasAll(['recordKey', 'platform', 'riderId', 'snapshotDate', 'sourceFile', 'sourceSheet', 'importBatchId', 'rowChecksum', 'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'])
        && data.keys().hasOnly([
          'recordKey', 'platform', 'riderId', 'snapshotDate', 'snapshotMonth', 'name', 'currentEstimatedLevel',
          'rankingPercentile', 'forcedAssignmentScore', 'estimatedRewardAmount', 'onTimeRate',
          'orderCompletionRate', 'didntTapDropOffTooEarly', 'orderVolume',
          'originalHeaders', 'rawExtraColumns',
          'sourceFile', 'sourceSheet', 'sourceRowNumber', 'importBatchId', 'rowChecksum',
          'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'
        ])
        && data.recordKey == docId && isValidId(data.recordKey)
        && data.platform == 'keeta'
        && data.riderId is string && data.riderId.size() >= 1 && data.riderId.size() <= 64
        && isValidIsoDate(data.snapshotDate)
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.importedAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidKeetaFacialDaily(data, docId) {
      return data.keys().hasAll(['recordKey', 'platform', 'riderId', 'date', 'month', 'sourceFile', 'sourceSheet', 'importBatchId', 'rowChecksum', 'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'])
        && data.keys().hasOnly([
          'recordKey', 'platform', 'riderId', 'date', 'month', 'city', 'partnerId', 'partnerName',
          'pmm', 'ifTriggeredToday', 'ifTriggeredTodayRaw', 'finalInspectionResult',
          'totalDaysTriggeredMtd', 'totalDaysPassedMtd', 'passRateMtd', 'over90PassRate',
          'originalHeaders', 'rawExtraColumns',
          'sourceFile', 'sourceSheet', 'sourceRowNumber', 'importBatchId', 'rowChecksum',
          'createdByUid', 'allowedUids', 'importedAt', 'updatedAt'
        ])
        && data.recordKey == docId && isValidId(data.recordKey)
        && data.platform == 'keeta'
        && data.riderId is string && data.riderId.size() >= 1 && data.riderId.size() <= 64
        && isValidIsoDate(data.date)
        && data.month is string && data.month.size() == 7
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.importedAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidDailySummary(data, docId) {
      return data.keys().hasAll(['summaryKey', 'platform', 'date', 'month', 'totalRiders', 'activeRiders', 'completedOrders', 'workingHours', 'createdByUid', 'allowedUids', 'updatedAt'])
        && data.keys().hasOnly([
          'summaryKey', 'platform', 'date', 'month', 'totalRiders', 'activeRiders',
          'completedOrders', 'acceptedOrders', 'rejectedOrders', 'cancelledOrders',
          'workingHours', 'validHours', 'totalKm', 'payableKm', 'overdueOrders',
          'avgAcceptanceRate', 'avgCompletionRate', 'avgOnTimeRate', 'avgAttendanceRate',
          'createdByUid', 'allowedUids', 'updatedAt'
        ])
        && data.summaryKey == docId && isValidId(data.summaryKey)
        && data.platform in ['hungerstation', 'keeta']
        && isValidIsoDate(data.date)
        && data.month is string && data.month.size() == 7
        && data.totalRiders is number && data.activeRiders is number
        && data.completedOrders is number && data.workingHours is number
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.updatedAt is timestamp;
