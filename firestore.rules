        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(riderMasterId) && isSupervisorOrAbove()
        && isValidRiderMaster(incoming(), riderMasterId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'city', 'branch', 'supervisor', 'contractName', 'vehicleType', 'status', 'allowedUids', 'updatedAt']));
      allow delete: if isValidId(riderMasterId) && isAdmin();
    }

    // 3. riderIdentityMapping
    match /riderIdentityMapping/{mappingId} {
