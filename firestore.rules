        && data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 128
        && isOptionalString(data, 'entityLabel', 180)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 1800
        && data.priority in ['critical', 'high', 'medium', 'low']
        && data.status in ['open', 'in_progress', 'closed']
        && isOptionalString(data, 'assigneeUid', 128)
        && isOptionalString(data, 'assigneeEmail', 200)
        && isOptionalString(data, 'dueDate', 10)
        && isOptionalString(data, 'actionTaken', 1000)
        && isOptionalString(data, 'resolutionNote', 1000)
        && isOptionalString(data, 'closedAt', 40)
        && isOptionalString(data, 'closedByEmail', 200)
        && isOptionalMap(data, 'customFields')
        && isValidId(data.createdByUid)
        && data.createdByEmail is string && data.createdByEmail.size() >= 3 && data.createdByEmail.size() <= 200
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ==========================================
    // SYSTEM BUILDER & CUSTOMIZATION VALIDATORS
    // ==========================================

    function isValidCompanyBranding(data, docId) {
      return data.keys().hasAll(['brandingId', 'company', 'branding', 'credits', 'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['brandingId', 'company', 'branding', 'credits', 'updatedByEmail', 'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'])
        && data.brandingId == docId && isValidId(data.brandingId)
        && data.company is map
        && data.branding is map
        && data.credits is map
        && isOptionalString(data, 'updatedByEmail', 200)
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSystemSection(data, docId) {
      return data.keys().hasAll(['sectionId', 'titleAr', 'titleEn', 'iconName', 'order', 'visible', 'isBuiltIn', 'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'sectionId', 'titleAr', 'titleEn', 'description', 'iconName', 'order',
          'visible', 'isBuiltIn', 'archived', 'allowedRoles',
          'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'
        ])
        && data.sectionId == docId && isValidId(data.sectionId)
        && data.titleAr is string && data.titleAr.size() >= 1 && data.titleAr.size() <= 120
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 120
        && isOptionalString(data, 'description', 400)
        && data.iconName is string && data.iconName.size() >= 1 && data.iconName.size() <= 60
        && data.order is number
        && data.visible is bool
        && data.isBuiltIn is bool
        && isOptionalBool(data, 'archived')
        && (!('allowedRoles' in data) || (data.allowedRoles is list && data.allowedRoles.size() <= 30))
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSystemPage(data, docId) {
      return data.keys().hasAll(['pageId', 'slug', 'titleAr', 'titleEn', 'sectionId', 'formId', 'iconName', 'order', 'visible', 'isBuiltIn', 'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'pageId', 'slug', 'titleAr', 'titleEn', 'description', 'sectionId', 'formId', 'iconName',
          'order', 'visible', 'isBuiltIn', 'archived', 'allowedRoles', 'tableColumns',
          'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'
        ])
        && data.pageId == docId && isValidId(data.pageId)
        && isValidId(data.slug)
        && data.titleAr is string && data.titleAr.size() >= 1 && data.titleAr.size() <= 120
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 120
        && isOptionalString(data, 'description', 400)
        && isValidId(data.sectionId)
        && isValidId(data.formId)
        && data.iconName is string && data.iconName.size() >= 1 && data.iconName.size() <= 60
        && data.order is number
        && data.visible is bool
        && data.isBuiltIn is bool
        && isOptionalBool(data, 'archived')
        && (!('allowedRoles' in data) || (data.allowedRoles is list && data.allowedRoles.size() <= 30))
        && (!('tableColumns' in data) || (data.tableColumns is list && data.tableColumns.size() <= 60))
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDynamicField(data, docId) {
      return data.keys().hasAll(['fieldId', 'key', 'labelAr', 'labelEn', 'type', 'module', 'formId', 'order', 'required', 'visible', 'editable', 'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'fieldId', 'key', 'labelAr', 'labelEn', 'description', 'placeholderAr', 'type', 'module', 'formId',
          'order', 'required', 'visible', 'editable', 'showInTable', 'isCore', 'archived',
          'defaultValue', 'options', 'validation', 'fileConfig', 'formulaExpression', 'permissions',
          'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'
        ])
        && data.fieldId == docId && isValidId(data.fieldId)
        && data.key is string && data.key.size() >= 1 && data.key.size() <= 64
        && data.labelAr is string && data.labelAr.size() >= 1 && data.labelAr.size() <= 120
        && data.labelEn is string && data.labelEn.size() >= 1 && data.labelEn.size() <= 120
        && isOptionalString(data, 'description', 400)
        && isOptionalString(data, 'placeholderAr', 150)
        && data.type in [
          'short_text', 'long_text', 'number', 'currency', 'date', 'datetime',
          'image', 'pdf', 'file', 'checkbox', 'dropdown', 'multiselect',
          'boolean', 'email', 'phone', 'url', 'percentage', 'formula'
        ]
        && data.module in ['hr', 'fleet', 'operations', 'executive', 'applications', 'custom']
        && isValidId(data.formId)
        && data.order is number
        && data.required is bool
        && data.visible is bool
        && data.editable is bool
        && isOptionalBool(data, 'showInTable')
        && isOptionalBool(data, 'isCore')
        && isOptionalBool(data, 'archived')
        && (!('options' in data) || (data.options is list && data.options.size() <= 100))
        && isOptionalMap(data, 'validation')
        && isOptionalMap(data, 'fileConfig')
        && isOptionalString(data, 'formulaExpression', 300)
        && isOptionalMap(data, 'permissions')
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDynamicForm(data, docId) {
      return data.keys().hasAll(['formId', 'nameAr', 'nameEn', 'module', 'targetEntity', 'layoutMode', 'sections', 'placements', 'publishedVersion', 'status', 'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'formId', 'nameAr', 'nameEn', 'description', 'module', 'targetEntity', 'layoutMode',
          'sections', 'placements', 'draftSections', 'draftPlacements', 'draftLayoutMode',
          'hasUnpublishedDraft', 'publishedVersion', 'status', 'updatedByEmail',
          'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'
        ])
        && data.formId == docId && isValidId(data.formId)
        && data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 140
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 140
        && isOptionalString(data, 'description', 400)
        && data.module in ['hr', 'fleet', 'operations', 'executive', 'applications', 'custom']
        && data.targetEntity is string && data.targetEntity.size() >= 1 && data.targetEntity.size() <= 80
        && data.layoutMode in ['sections', 'tabs', 'wizard']
        && data.sections is list && data.sections.size() <= 30
        && data.placements is list && data.placements.size() <= 150
        && (!('draftSections' in data) || (data.draftSections is list && data.draftSections.size() <= 30))
        && (!('draftPlacements' in data) || (data.draftPlacements is list && data.draftPlacements.size() <= 150))
        && (!('draftLayoutMode' in data) || data.draftLayoutMode in ['sections', 'tabs', 'wizard'])
        && isOptionalBool(data, 'hasUnpublishedDraft')
        && data.publishedVersion is number
        && data.status in ['published', 'draft']
        && isOptionalString(data, 'updatedByEmail', 200)
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDynamicFormVersion(data, docId) {
      return data.keys().hasAll(['versionId', 'formId', 'versionNumber', 'layoutMode', 'sections', 'placements', 'publishedByUid', 'publishedByEmail', 'createdByUid', 'allowedUids', 'createdAt'])
        && data.keys().hasOnly([
          'versionId', 'formId', 'versionNumber', 'layoutMode', 'sections', 'placements',
          'changeNote', 'publishedByUid', 'publishedByEmail', 'createdByUid', 'allowedUids', 'createdAt'
        ])
        && data.versionId == docId && isValidId(data.versionId)
        && isValidId(data.formId)
        && data.versionNumber is number
        && data.layoutMode in ['sections', 'tabs', 'wizard']
        && data.sections is list && data.sections.size() <= 30
        && data.placements is list && data.placements.size() <= 150
        && isOptionalString(data, 'changeNote', 400)
        && isValidId(data.publishedByUid)
        && data.publishedByEmail is string && data.publishedByEmail.size() <= 200
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp;
    }

    function isValidCustomEntityRecord(data, docId) {
      return data.keys().hasAll(['recordId', 'pageId', 'formId', 'title', 'customFields', 'createdByUid', 'createdByEmail', 'allowedUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'recordId', 'pageId', 'formId', 'title', 'status', 'branch', 'city',
          'customFields', 'archived', 'createdByUid', 'createdByEmail', 'updatedByEmail',
          'allowedUids', 'createdAt', 'updatedAt'
        ])
        && data.recordId == docId && isValidId(data.recordId)
        && isValidId(data.pageId)
        && isValidId(data.formId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && isOptionalString(data, 'status', 64)
        && isOptionalString(data, 'branch', 100)
        && isOptionalString(data, 'city', 100)
        && data.customFields is map
        && isOptionalBool(data, 'archived')
        && isValidId(data.createdByUid)
        && data.createdByEmail is string && data.createdByEmail.size() <= 200
        && isOptionalString(data, 'updatedByEmail', 200)
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedView(data, docId) {
      return data.keys().hasAll(['viewId', 'scope', 'nameAr', 'filters', 'isShared', 'ownerUid', 'ownerEmail', 'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'viewId', 'scope', 'nameAr', 'filters', 'visibleColumns', 'columnOrder',
          'isShared', 'ownerUid', 'ownerEmail', 'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'
        ])
        && data.viewId == docId && isValidId(data.viewId)
        && data.scope is string && data.scope.size() >= 1 && data.scope.size() <= 80
        && data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 120
        && data.filters is map
        && (!('visibleColumns' in data) || (data.visibleColumns is list && data.visibleColumns.size() <= 80))
        && (!('columnOrder' in data) || (data.columnOrder is list && data.columnOrder.size() <= 80))
        && data.isShared is bool
        && isValidId(data.ownerUid)
        && data.ownerEmail is string && data.ownerEmail.size() <= 200
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPreference(data, userId) {
      return data.keys().hasAll(['userId', 'createdByUid', 'allowedUids', 'updatedAt'])
        && data.keys().hasOnly([
          'userId', 'defaultNav', 'dashboardDateWindow', 'dashboardWidgets',
          'tableColumns', 'sidebarCollapsed', 'createdByUid', 'allowedUids', 'updatedAt'
        ])
        && data.userId == userId && isValidId(data.userId)
        && isOptionalString(data, 'defaultNav', 80)
        && (!('dashboardDateWindow' in data) || data.dashboardDateWindow in ['today', '7d', '30d', 'month'])
        && (!('dashboardWidgets' in data) || (data.dashboardWidgets is list && data.dashboardWidgets.size() <= 40))
        && isOptionalMap(data, 'tableColumns')
        && isOptionalBool(data, 'sidebarCollapsed')
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.updatedAt is timestamp;
    }

    function isValidNotificationRule(data, docId) {
      return data.keys().hasAll(['ruleId', 'nameAr', 'module', 'eventType', 'severity', 'targetRoles', 'enabled', 'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ruleId', 'nameAr', 'description', 'module', 'eventType', 'severity',
          'thresholdDaysOrValue', 'targetRoles', 'enabled', 'createdByUid', 'allowedUids', 'createdAt', 'updatedAt'
        ])
        && data.ruleId == docId && isValidId(data.ruleId)
        && data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 140
        && isOptionalString(data, 'description', 400)
        && data.module is string && data.module.size() >= 1 && data.module.size() <= 64
        && data.eventType is string && data.eventType.size() >= 1 && data.eventType.size() <= 80
        && data.severity in ['critical', 'warning', 'info']
        && isOptionalNum(data, 'thresholdDaysOrValue')
        && data.targetRoles is list && data.targetRoles.size() <= 30
        && data.enabled is bool
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrashItem(data, docId) {
      return data.keys().hasAll(['trashId', 'itemType', 'sourceCollection', 'sourceDocId', 'titleAr', 'snapshotJson', 'deletedByUid', 'deletedByEmail', 'status', 'createdByUid', 'allowedUids', 'createdAt'])
        && data.keys().hasOnly([
          'trashId', 'itemType', 'sourceCollection', 'sourceDocId', 'titleAr', 'summary',
          'snapshotJson', 'deletedByUid', 'deletedByEmail', 'restoredAt', 'restoredByEmail',
          'status', 'createdByUid', 'allowedUids', 'createdAt'
        ])
        && data.trashId == docId && isValidId(data.trashId)
        && data.itemType in ['dynamic_field', 'dynamic_form', 'system_section', 'system_page', 'custom_record', 'rider', 'vehicle']
        && data.sourceCollection is string && data.sourceCollection.size() >= 1 && data.sourceCollection.size() <= 80
        && data.sourceDocId is string && data.sourceDocId.size() >= 1 && data.sourceDocId.size() <= 128
        && data.titleAr is string && data.titleAr.size() >= 1 && data.titleAr.size() <= 200
        && isOptionalString(data, 'summary', 500)
        && data.snapshotJson is string && data.snapshotJson.size() >= 2 && data.snapshotJson.size() <= 120000
        && isValidId(data.deletedByUid)
        && data.deletedByEmail is string && data.deletedByEmail.size() <= 200
        && isOptionalString(data, 'restoredAt', 40)
        && isOptionalString(data, 'restoredByEmail', 200)
        && data.status in ['deleted', 'restored', 'purged']
        && isValidId(data.createdByUid)
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp;
    }

    function isValidConfigSnapshot(data, docId) {
      return data.keys().hasAll(['snapshotId', 'nameAr', 'payloadJson', 'createdByUid', 'createdByEmail', 'allowedUids', 'createdAt'])
        && data.keys().hasOnly(['snapshotId', 'nameAr', 'description', 'payloadJson', 'createdByUid', 'createdByEmail', 'allowedUids', 'createdAt'])
        && data.snapshotId == docId && isValidId(data.snapshotId)
        && data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 140
        && isOptionalString(data, 'description', 400)
        && data.payloadJson is string && data.payloadJson.size() >= 2 && data.payloadJson.size() <= 400000
        && isValidId(data.createdByUid)
        && data.createdByEmail is string && data.createdByEmail.size() <= 200
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp;
    }

    function isValidCustomReportTemplate(data, docId) {
      return data.keys().hasAll(['templateId', 'nameAr', 'dataSource', 'columns', 'headerTitle', 'includeCompanyLogo', 'includeCompanyDetails', 'orientation', 'createdByUid', 'createdByEmail', 'allowedUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'templateId', 'nameAr', 'dataSource', 'customPageId', 'columns', 'headerTitle',
          'headerSubtitle', 'footerNote', 'preparerName', 'includeCompanyLogo',
          'includeCompanyDetails', 'orientation', 'createdByUid', 'createdByEmail',
          'allowedUids', 'createdAt', 'updatedAt'
        ])
        && data.templateId == docId && isValidId(data.templateId)
        && data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 140
        && data.dataSource in ['riders', 'vehicles', 'operations_daily', 'expiries', 'maintenance', 'custom_page']
        && isOptionalString(data, 'customPageId', 128)
        && data.columns is list && data.columns.size() >= 1 && data.columns.size() <= 60
        && data.headerTitle is string && data.headerTitle.size() >= 1 && data.headerTitle.size() <= 180
        && isOptionalString(data, 'headerSubtitle', 250)
        && isOptionalString(data, 'footerNote', 300)
        && isOptionalString(data, 'preparerName', 120)
        && data.includeCompanyLogo is bool
        && data.includeCompanyDetails is bool
        && data.orientation in ['landscape', 'portrait']
        && isValidId(data.createdByUid)
        && data.createdByEmail is string && data.createdByEmail.size() <= 200
        && isValidAllowedUids(data.allowedUids)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 1. users (Strict PII isolation)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin() || hasModulePerm('users', 'view'));
      allow list: if isVerified() && (
        isBootstrappedOwner()
        || existing().uid == request.auth.uid
        || (existing().managedByAdminUids is list && existing().managedByAdminUids.size() <= 10 && request.auth.uid in existing().managedByAdminUids)
      );
      allow create: if isVerified() && isValidId(userId) && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isBootstrappedOwner() && userId == request.auth.uid && incoming().role == 'owner' && incoming().active == true)
          || (userId == request.auth.uid && incoming().role == 'viewer' && incoming().active == false)
          || isAdmin()
          || hasModulePerm('users', 'add')
        );
      allow update: if isVerified() && isValidId(userId) && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || hasModulePerm('users', 'edit')
          || (isOwner(userId)
              && incoming().role == existing().role
              && incoming().active == existing().active
              && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && (isBootstrappedOwner() || hasModulePerm('users', 'delete')) && userId != request.auth.uid;
    }

    // 2. riderMaster
    match /riderMaster/{riderMasterId} {
      allow get: if isValidId(riderMasterId) && (isActiveMember() || hasModulePerm('hr', 'view'));
      allow list: if canListResource();
      allow create: if isValidId(riderMasterId) && (isSupervisorOrAbove() || isHrStaff() || hasModulePerm('hr', 'add'))
        && isValidRiderMaster(incoming(), riderMasterId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(riderMasterId) && (isSupervisorOrAbove() || isHrStaff() || hasModulePerm('hr', 'edit'))
        && isValidRiderMaster(incoming(), riderMasterId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || hasModulePerm('hr', 'edit') || incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'iqamaNumber', 'iqamaIssueDate', 'iqamaExpiryDate', 'iqamaRenewalNotes',
          'phone', 'birthDate', 'nationality', 'joinDate', 'exitDate',
          'driverLicenseNumber', 'driverLicenseType', 'driverLicenseIssueDate', 'driverLicenseExpiryDate',
          'adminNotes', 'city', 'branch', 'supervisor', 'contractName', 'vehicleType',
          'status', 'statusHistory', 'customFields', 'allowedUids', 'updatedAt'
        ]));
      allow delete: if isValidId(riderMasterId) && (isAdmin() || hasModulePerm('hr', 'delete'));
    }

    // 3. riderIdentityMapping
    match /riderIdentityMapping/{mappingId} {
      allow get: if isValidId(mappingId) && isActiveMember() && hasPlatformAccess(existing().platform);
      allow list: if canListResource();
      allow create: if isValidId(mappingId) && isSupervisorOrAbove() && hasPlatformAccess(incoming().platform)
        && isValidRiderIdentityMapping(incoming(), mappingId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/riderMaster/$(incoming().internalRiderId));
      allow update: if isValidId(mappingId) && isSupervisorOrAbove() && hasPlatformAccess(incoming().platform)
        && isValidRiderIdentityMapping(incoming(), mappingId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['internalRiderId', 'platformRiderName', 'allowedUids', 'updatedAt']));
      allow delete: if isValidId(mappingId) && isOpsManagerOrAbove();
    }

    // 4. importBatches
    match /importBatches/{batchId} {
      allow get: if isValidId(batchId) && isActiveMember() && hasPlatformAccess(existing().platform);
      allow list: if canListResource();
      allow create: if isValidId(batchId) && isOpsManagerOrAbove()
        && isValidImportBatch(incoming(), batchId)
        && hasPlatformAccess(incoming().platform)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(batchId) && isOpsManagerOrAbove()
        && isValidImportBatch(incoming(), batchId)
        && hasPlatformAccess(incoming().platform)
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && (isAdmin() || (existing().status != 'committed' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'validCount', 'duplicateCount', 'rejectedCount', 'updatedCount', 'allowedUids'])));
      allow delete: if isValidId(batchId) && isAdmin();
    }

    // 5. hungerDaily
    match /hungerDaily/{recordKey} {
      allow get: if isValidId(recordKey) && hasPlatformAccess('hungerstation');
      allow list: if canListResource();
      allow create: if isValidId(recordKey) && isOpsManagerOrAbove() && hasPlatformAccess('hungerstation')
        && isValidHungerDaily(incoming(), recordKey)
        && incoming().createdByUid == request.auth.uid
        && incoming().importedAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(recordKey) && isOpsManagerOrAbove() && hasPlatformAccess('hungerstation')
        && isValidHungerDaily(incoming(), recordKey)
        && incoming().createdByUid == existing().createdByUid
        && incoming().importedAt == existing().importedAt
        && incoming().updatedAt == request.time
        && (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly([
          'city', 'contractName', 'vehicleName', 'batchNumber', 'tgaStatus', 'errorCodes',
          'shifts', 'plannedWorkingHours', 'actualWorkingHours', 'avgWorkingHoursPerDay',
          'attendanceRate', 'breakHours', 'lostHours', 'acceptanceRate', 'contactRate',
          'noShows', 'noShowPct', 'notifiedDeliveries', 'completedDeliveries', 'acceptedDeliveries',
          'stackedDeliveries', 'declinedDeliveries', 'cancelledDeliveries', 'deductionDeliveries',
          'notAcceptedDeliveries', 'manualUndispatched', 'chatResponsePct',
          'sourceFile', 'sourceSheet', 'sourceRowNumber', 'importBatchId', 'rowChecksum',
          'allowedUids', 'updatedAt'
        ]));
      allow delete: if isValidId(recordKey) && isAdmin();
    }

    // 6. hungerDistanceDaily
    match /hungerDistanceDaily/{recordKey} {
      allow get: if isValidId(recordKey) && hasPlatformAccess('hungerstation');
