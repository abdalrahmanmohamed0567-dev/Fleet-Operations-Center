    // 20. riderNotes
    match /riderNotes/{noteId} {
      allow get: if isValidId(noteId) && isActiveMember();
      allow list: if canListResource();
      allow create: if isValidId(noteId) && isSupervisorOrAbove()
        && isValidRiderNote(incoming(), noteId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(noteId) && isSupervisorOrAbove()
        && (isAdmin() || existing().createdByUid == request.auth.uid)
        && isValidRiderNote(incoming(), noteId)
        && incoming().createdByUid == existing().createdByUid
        && incoming().riderKey == existing().riderKey
        && incoming().platform == existing().platform
        && incoming().riderId == existing().riderId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['category', 'content', 'allowedUids', 'updatedAt']);
      allow delete: if isValidId(noteId) && (isAdmin() || existing().createdByUid == request.auth.uid);
    }
  }
}
